SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DASHBOARD_PASSWORD=
DASHBOARD_SECRET=
GOOGLE_PLACES_API_KEY=
GEMINI_API_KEY=
# Optional: Gemini model for AI features (default gemini-3.5-flash-lite)
GEMINI_MODEL=
# Email for reminders and assignments (Resend). RESEND_FROM must be on a verified domain, e.g. "UX4U <desk@ux4u.online>"
RESEND_API_KEY=
RESEND_FROM=
# Long random string; Vercel Cron sends it to /api/cron/daily
CRON_SECRET=
# Base URL used in email links (defaults to the site URL)
APP_URL=
